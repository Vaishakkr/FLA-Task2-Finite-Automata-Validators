digraph "ATM PIN (4 or 6 digits)" {
  rankdir=LR; bgcolor="white";
  node [shape=circle fontname="Helvetica" fontsize=11];
  edge [fontname="Helvetica" fontsize=10];
  __start [shape=point width=0.08];
  "q0" [shape=circle];
  "q1" [shape=circle];
  "q2" [shape=circle];
  "q3" [shape=circle];
  "q4" [shape=doublecircle];
  "q5" [shape=circle];
  "q6" [shape=doublecircle];
  __start -> "q0";
  "q0" -> "q1" [label="D"];
  "q1" -> "q2" [label="D"];
  "q2" -> "q3" [label="D"];
  "q3" -> "q4" [label="D"];
  "q4" -> "q5" [label="D"];
  "q5" -> "q6" [label="D"];
}