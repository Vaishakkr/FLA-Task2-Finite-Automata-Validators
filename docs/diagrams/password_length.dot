digraph "length 8..16" {
  rankdir=LR; bgcolor="white";
  node [shape=circle fontname="Helvetica" fontsize=11];
  edge [fontname="Helvetica" fontsize=10];
  __start [shape=point width=0.08];
  "l0" [shape=circle];
  "l1" [shape=circle];
  "l2" [shape=circle];
  "l3" [shape=circle];
  "l4" [shape=circle];
  "l5" [shape=circle];
  "l6" [shape=circle];
  "l7" [shape=circle];
  "l8" [shape=doublecircle];
  "l9" [shape=doublecircle];
  "l10" [shape=doublecircle];
  "l11" [shape=doublecircle];
  "l12" [shape=doublecircle];
  "l13" [shape=doublecircle];
  "l14" [shape=doublecircle];
  "l15" [shape=doublecircle];
  "l16" [shape=doublecircle];
  __start -> "l0";
  "l0" -> "l1" [label="U, L, D, S"];
  "l1" -> "l2" [label="U, L, D, S"];
  "l2" -> "l3" [label="U, L, D, S"];
  "l3" -> "l4" [label="U, L, D, S"];
  "l4" -> "l5" [label="U, L, D, S"];
  "l5" -> "l6" [label="U, L, D, S"];
  "l6" -> "l7" [label="U, L, D, S"];
  "l7" -> "l8" [label="U, L, D, S"];
  "l8" -> "l9" [label="U, L, D, S"];
  "l9" -> "l10" [label="U, L, D, S"];
  "l10" -> "l11" [label="U, L, D, S"];
  "l11" -> "l12" [label="U, L, D, S"];
  "l12" -> "l13" [label="U, L, D, S"];
  "l13" -> "l14" [label="U, L, D, S"];
  "l14" -> "l15" [label="U, L, D, S"];
  "l15" -> "l16" [label="U, L, D, S"];
}