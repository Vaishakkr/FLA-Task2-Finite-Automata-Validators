digraph "Character-class coverage" {
  rankdir=LR; bgcolor="white";
  node [shape=circle fontname="Helvetica" fontsize=11];
  edge [fontname="Helvetica" fontsize=10];
  __start [shape=point width=0.08];
  "none" [shape=circle];
  "U" [shape=circle];
  "L" [shape=circle];
  "D" [shape=circle];
  "S" [shape=circle];
  "UL" [shape=circle];
  "UD" [shape=circle];
  "US" [shape=circle];
  "LD" [shape=circle];
  "LS" [shape=circle];
  "DS" [shape=circle];
  "ULD" [shape=circle];
  "ULS" [shape=circle];
  "UDS" [shape=circle];
  "LDS" [shape=circle];
  "ULDS" [shape=doublecircle];
  __start -> "none";
  "none" -> "U" [label="U"];
  "none" -> "L" [label="L"];
  "none" -> "D" [label="D"];
  "none" -> "S" [label="S"];
  "U" -> "U" [label="U"];
  "U" -> "UL" [label="L"];
  "U" -> "UD" [label="D"];
  "U" -> "US" [label="S"];
  "L" -> "UL" [label="U"];
  "L" -> "L" [label="L"];
  "L" -> "LD" [label="D"];
  "L" -> "LS" [label="S"];
  "D" -> "UD" [label="U"];
  "D" -> "LD" [label="L"];
  "D" -> "D" [label="D"];
  "D" -> "DS" [label="S"];
  "S" -> "US" [label="U"];
  "S" -> "LS" [label="L"];
  "S" -> "DS" [label="D"];
  "S" -> "S" [label="S"];
  "UL" -> "UL" [label="U, L"];
  "UL" -> "ULD" [label="D"];
  "UL" -> "ULS" [label="S"];
  "UD" -> "UD" [label="U, D"];
  "UD" -> "ULD" [label="L"];
  "UD" -> "UDS" [label="S"];
  "US" -> "US" [label="U, S"];
  "US" -> "ULS" [label="L"];
  "US" -> "UDS" [label="D"];
  "LD" -> "ULD" [label="U"];
  "LD" -> "LD" [label="L, D"];
  "LD" -> "LDS" [label="S"];
  "LS" -> "ULS" [label="U"];
  "LS" -> "LS" [label="L, S"];
  "LS" -> "LDS" [label="D"];
  "DS" -> "UDS" [label="U"];
  "DS" -> "LDS" [label="L"];
  "DS" -> "DS" [label="D, S"];
  "ULD" -> "ULD" [label="U, L, D"];
  "ULD" -> "ULDS" [label="S"];
  "ULS" -> "ULS" [label="U, L, S"];
  "ULS" -> "ULDS" [label="D"];
  "UDS" -> "UDS" [label="U, D, S"];
  "UDS" -> "ULDS" [label="L"];
  "LDS" -> "ULDS" [label="U"];
  "LDS" -> "LDS" [label="L, D, S"];
  "ULDS" -> "ULDS" [label="U, L, D, S"];
}